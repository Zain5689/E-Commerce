datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
}

enum Condition {
  NEW
  USED
  REFURBISHED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  PAYMOB
  FAWRY
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ----------------------------------------------------
// USERS & ADDRESSES
// ----------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses    Address[]
  orders       Order[]
  carts        Cart[]
  wishlists    Wishlist[]
  reviews      Review[]

  @@index([email])
}

model Governorate {
  id          String   @id @default(uuid())
  nameEn      String
  nameAr      String
  shippingFee Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  cities      City[]
  addresses   Address[]
}

model City {
  id            String      @id @default(uuid())
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  nameEn        String
  nameAr        String
  shippingFee   Decimal?    @db.Decimal(10, 2)
  addresses     Address[]
}

model Address {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id])
  cityId        String
  city          City        @relation(fields: [cityId], references: [id])
  street        String
  building      String
  floor         String?
  apartment     String?
  phone         String
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  orders        Order[]
}

// ----------------------------------------------------
// CATEGORIES, BRANDS & PRODUCTS
// ----------------------------------------------------

model Category {
  id           String     @id @default(uuid())
  nameEn       String
  nameAr       String
  slug         String     @unique
  icon         String?
  image        String?
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[] @relation("CategoryHierarchy")
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())

  products     Product[]
  specKeys     SpecificationKey[]

  @@index([slug])
}

model Brand {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  logo     String?
  products Product[]
}

model Product {
  id              String      @id @default(uuid())
  nameEn          String
  nameAr          String
  slug            String      @unique
  descriptionEn   String      @db.Text
  descriptionAr   String      @db.Text
  sku             String      @unique
  condition       Condition   @default(NEW)
  basePrice       Decimal     @db.Decimal(10, 2)
  discountPrice   Decimal?    @db.Decimal(10, 2)
  stockQuantity   Int         @default(0)
  isPublished     Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  brandId        String
  brand          Brand       @relation(fields: [brandId], references: [id])

  images         ProductImage[]
  specifications ProductSpecification[]
  variants       ProductVariant[]
  reviews        Review[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]

  @@index([slug, categoryId, brandId, condition])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
}

// ----------------------------------------------------
// DYNAMIC TECHNICAL SPECIFICATIONS
// ----------------------------------------------------

model SpecificationKey {
  id           String   @id @default(uuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameEn       String
  nameAr       String
  unit         String?
  isFilterable Boolean  @default(true)

  productSpecs ProductSpecification[]
}

model ProductSpecification {
  id                 String           @id @default(uuid())
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  specificationKeyId String
  specificationKey   SpecificationKey @relation(fields: [specificationKeyId], references: [id], onDelete: Cascade)
  valueEn            String
  valueAr            String

  @@index([specificationKeyId, valueEn])
}

// ----------------------------------------------------
// PRODUCT VARIANTS
// ----------------------------------------------------

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String   @unique
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  image         String?
  attributes    Json
  createdAt     DateTime @default(now())

  cartItems     CartItem[]
  orderItems    OrderItem[]
}

// ----------------------------------------------------
// CART & WISHLIST
// ----------------------------------------------------

model Cart {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  items        CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
}

model Wishlist {
  id     String         @id @default(uuid())
  userId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// ----------------------------------------------------
// ORDERS & PAYMENTS
// ----------------------------------------------------

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  guestEmail      String?
  guestName       String?
  guestPhone      String?
  addressId       String?
  address         Address?      @relation(fields: [addressId], references: [id])
  shippingAddress Json

  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  paymentRef      String?

  subtotal        Decimal       @db.Decimal(10, 2)
  shippingFee     Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)

  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  unitPrice  Decimal         @db.Decimal(10, 2)
  quantity   Int
  totalPrice Decimal         @db.Decimal(10, 2)
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  discountType      DiscountType
  discountValue     Decimal      @db.Decimal(10, 2)
  minOrderAmount    Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  usageLimit        Int?
  usageCount        Int          @default(0)
  expiresAt         DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())

  orders            Order[]
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}
